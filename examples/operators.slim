
log(sizeof [1, 2, 3]) // 3
log(sizeof { key: "value" }) // 1


log(empty []) // true
log(empty {}) // true
log(empty null) // true
log(empty [1, 2, 3]) // false


log(kindof []) // null[]
log(kindof [1, 2, 3]) // int[]
log(kindof null) // null
log(kindof [1, "hello"]) // array
log(kindof 1.5) // float


